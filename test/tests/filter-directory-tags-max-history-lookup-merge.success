#!/bin/sh

# The --tags-max-history-lookup option limits the depth of the history to be inspected, not the number of the inspected commits:
# when a tag is associated to a merge commit, the commits of the other merged branch must not reduce the inspected depth.

. "$(cd -- "$(dirname -- "${0}")" && pwd -P)/../bootstrap"

# $1: the name of the file to be created
# $2: the commit message
addCommit() {
	touch "${DIR_SOURCE}/${1}"
	git -C "${DIR_SOURCE}" add --all
	git -C "${DIR_SOURCE}" commit --quiet --message "${2}"
}

# $1: the value of the --tags-max-history-lookup option
# $2: the expected tags
# $3: the message of the commit expected for tag-05 (empty if we don't expect that tag)
checkTags() {
	initializeRepositories
	git -C "${DIR_SOURCE}" checkout --quiet master
	git -C "${DIR_SOURCE}" checkout --quiet -b release
	addCommit rootfile4 'Commit #9'
	addCommit subdir/subfile4 'Commit #10'
	addCommit rootfile5 'Commit #11'
	git -C "${DIR_SOURCE}" checkout --quiet master
	addCommit rootfile6 'Commit #12'
	addCommit rootfile7 'Commit #13'
	addCommit rootfile8 'Commit #14'
	addCommit rootfile9 'Commit #15'
	git -C "${DIR_SOURCE}" merge --quiet --no-ff -m 'Merge release' release
	git -C "${DIR_SOURCE}" tag tag-05
	addCommit rootfile10 'Commit #16'

	"${BIN_MAIN}" ${BIN_MAIN_OPTIONS} --workdir "${DIR_TEMP}" --branch-whitelist 'master' --tags-plan all --tags-max-history-lookup "${1}" -- "${DIR_SOURCE}" '--prune-empty --subdirectory-filter subdir' "${DIR_DESTINATION}"

	echo 'Checking tags'
	actualTags="$(getTagList "${DIR_DESTINATION}")"
	if [ "${actualTags}" != "${2}" ]; then
		printf 'Max history lookup: %s\nExpected tags: %s\nResulting tags: %s\n' "${1}" "${2}" "${actualTags}" >&2
		exit 1
	fi
	if [ -n "${3}" ]; then
		echo 'Checking commit of tag-05'
		actualTagCommit="$(git -C "${DIR_DESTINATION}" log -1 --format=%s 'refs/tags/tag-05^{commit}')"
		if [ "${actualTagCommit}" != "${3}" ]; then
			printf 'Max history lookup: %s\nExpected commit of tag-05: %s\nResulting commit of tag-05: %s\n' "${1}" "${3}" "${actualTagCommit}" >&2
			exit 1
		fi
	fi
}

# tag-05 is associated to the merge commit (depth 1), its parents are Commit #15 and Commit #11 (depth 2), Commit #10 is at depth 3
checkTags 2 'tag-02 tag-03' ''
checkTags 3 'tag-02 tag-03 tag-05' 'Commit #10'
